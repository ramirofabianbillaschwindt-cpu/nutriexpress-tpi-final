<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_NutriExpress" targetNamespace="https://nutriexpress.example/tpi" exporter="NutriExpress TPI" exporterVersion="1.0">
  <bpmn:error id="ErrStock" name="Stock insuficiente" errorCode="STOCK_INSUFICIENTE"/>
  <bpmn:error id="ErrRegistro" name="Fallo técnico de registro" errorCode="ERROR_REGISTRO"/>
  <bpmn:process id="ProcesoProduccion" name="Planificación y confirmación de producción" isExecutable="false">
    <bpmn:laneSet id="ProcesoProduccion_lanes">
      <bpmn:lane id="ProcesoProduccion_lane0" name="Ventas">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Seleccionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Acordar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Actualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinAlternativo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ProcesoProduccion_lane1" name="Sistema">
        <bpmn:flowNodeRef>Calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Alertas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinProduccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StockCambio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ErrorRegistro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resolver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ProcesoProduccion_lane2" name="Compras y Depósito">
        <bpmn:flowNodeRef>Abastecer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Abastecido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ProcesoProduccion_lane3" name="Cocina y Producción">
        <bpmn:flowNodeRef>Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Elaborar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Planificación diaria">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Seleccionar" name="Seleccionar pedidos confirmados">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Calcular" name="Calcular requerimientos y stock utilizable">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
    <bpmn:outgoing>F3</bpmn:outgoing>
      </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Stock" name="¿Stock suficiente?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Confirmar" name="Revisar y confirmar producción">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Registrar" name="Validar y registrar consumo atómico">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
    <bpmn:outgoing>F7</bpmn:outgoing>
      </bpmn:serviceTask>
    <bpmn:userTask id="Elaborar" name="Elaborar viandas">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Alertas" name="Actualizar existencias y alertas">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FinProduccion" name="Producción registrada">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Abastecer" name="Gestionar faltante" calledElement="ProcesoAbastecimiento">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
    <bpmn:outgoing>F10</bpmn:outgoing>
      </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Abastecido" name="¿Abastecido?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Acordar" name="Acordar reprogramación o cancelación">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Actualizar" name="Actualizar estado y fecha del pedido">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="FinAlternativo" name="Planificación reprogramada o cancelada">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="StockCambio" name="Stock cambió" attachedToRef="Registrar" cancelActivity="true">
      <bpmn:outgoing>F15</bpmn:outgoing>
    <bpmn:errorEventDefinition id="StockCambio_def" errorRef="ErrStock"/>
      </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="ErrorRegistro" name="Fallo técnico" attachedToRef="Registrar" cancelActivity="true">
      <bpmn:outgoing>F16</bpmn:outgoing>
    <bpmn:errorEventDefinition id="ErrorRegistro_def" errorRef="ErrRegistro"/>
      </bpmn:boundaryEvent>
    <bpmn:userTask id="Resolver" name="Resolver incidente y autorizar reintento">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="Seleccionar" name=""/>
    <bpmn:sequenceFlow id="F2" sourceRef="Seleccionar" targetRef="Calcular" name=""/>
    <bpmn:sequenceFlow id="F3" sourceRef="Calcular" targetRef="Stock" name=""/>
    <bpmn:sequenceFlow id="F4" sourceRef="Stock" targetRef="Confirmar" name="Sí"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Stock" targetRef="Abastecer" name="No"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Confirmar" targetRef="Registrar" name=""/>
    <bpmn:sequenceFlow id="F7" sourceRef="Registrar" targetRef="Elaborar" name=""/>
    <bpmn:sequenceFlow id="F8" sourceRef="Elaborar" targetRef="Alertas" name=""/>
    <bpmn:sequenceFlow id="F9" sourceRef="Alertas" targetRef="FinProduccion" name=""/>
    <bpmn:sequenceFlow id="F10" sourceRef="Abastecer" targetRef="Abastecido" name=""/>
    <bpmn:sequenceFlow id="F11" sourceRef="Abastecido" targetRef="Calcular" name="Sí · recalcular"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Abastecido" targetRef="Acordar" name="No"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Acordar" targetRef="Actualizar" name=""/>
    <bpmn:sequenceFlow id="F14" sourceRef="Actualizar" targetRef="FinAlternativo" name=""/>
    <bpmn:sequenceFlow id="F15" sourceRef="StockCambio" targetRef="Abastecer" name=""/>
    <bpmn:sequenceFlow id="F16" sourceRef="ErrorRegistro" targetRef="Resolver" name=""/>
    <bpmn:sequenceFlow id="F17" sourceRef="Resolver" targetRef="Registrar" name="Reintento seguro"/>
  </bpmn:process>
  <bpmn:collaboration id="ProcesoProduccion_coll">
    <bpmn:participant id="ProcesoProduccion_pool" name="NutriExpress S.R.L." processRef="ProcesoProduccion"/>
  </bpmn:collaboration>
  <bpmn:process id="ProcesoAbastecimiento" name="Gestionar faltante de insumos" isExecutable="false">
    <bpmn:laneSet id="ProcesoAbastecimiento_lanes">
      <bpmn:lane id="ProcesoAbastecimiento_lane0" name="Compras y Depósito">
        <bpmn:flowNodeRef>BInicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Solicitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Respuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Viable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Entrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inspeccionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Conforme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoViable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BFinNo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ProcesoAbastecimiento_lane1" name="Sistema">
        <bpmn:flowNodeRef>BLotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BFinSi</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BInicio" name="Faltante recibido">
      <bpmn:outgoing>B1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Solicitar" name="Solicitar disponibilidad y plazo">
      <bpmn:incoming>B1</bpmn:incoming>
      <bpmn:outgoing>B2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Respuesta" name="Recibir disponibilidad y plazo">
      <bpmn:incoming>B2</bpmn:incoming>
      <bpmn:outgoing>B3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Viable" name="¿Provisión en plazo?">
      <bpmn:incoming>B3</bpmn:incoming>
      <bpmn:outgoing>B4</bpmn:outgoing>
      <bpmn:outgoing>B5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Entrega" name="Recibir insumos del proveedor">
      <bpmn:incoming>B4</bpmn:incoming>
      <bpmn:outgoing>B6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Inspeccionar" name="Verificar cantidad y vencimiento">
      <bpmn:incoming>B6</bpmn:incoming>
      <bpmn:outgoing>B7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Conforme" name="¿Recepción conforme?">
      <bpmn:incoming>B7</bpmn:incoming>
      <bpmn:outgoing>B8</bpmn:outgoing>
      <bpmn:outgoing>B9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BLotes" name="Registrar lotes y movimientos de ingreso">
      <bpmn:incoming>B8</bpmn:incoming>
      <bpmn:outgoing>B12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BFinSi" name="Abastecido">
      <bpmn:incoming>B12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="NoViable" name="Informar imposibilidad de abastecimiento">
      <bpmn:incoming>B5</bpmn:incoming>
      <bpmn:outgoing>B10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Rechazar" name="Rechazar recepción e informar desvío">
      <bpmn:incoming>B9</bpmn:incoming>
      <bpmn:outgoing>B11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="BFinNo" name="No abastecido">
      <bpmn:incoming>B10</bpmn:incoming>
      <bpmn:incoming>B11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B1" sourceRef="BInicio" targetRef="Solicitar" name=""/>
    <bpmn:sequenceFlow id="B2" sourceRef="Solicitar" targetRef="Respuesta" name=""/>
    <bpmn:sequenceFlow id="B3" sourceRef="Respuesta" targetRef="Viable" name=""/>
    <bpmn:sequenceFlow id="B4" sourceRef="Viable" targetRef="Entrega" name="Sí"/>
    <bpmn:sequenceFlow id="B5" sourceRef="Viable" targetRef="NoViable" name="No"/>
    <bpmn:sequenceFlow id="B6" sourceRef="Entrega" targetRef="Inspeccionar" name=""/>
    <bpmn:sequenceFlow id="B7" sourceRef="Inspeccionar" targetRef="Conforme" name=""/>
    <bpmn:sequenceFlow id="B8" sourceRef="Conforme" targetRef="BLotes" name="Sí"/>
    <bpmn:sequenceFlow id="B9" sourceRef="Conforme" targetRef="Rechazar" name="No"/>
    <bpmn:sequenceFlow id="B10" sourceRef="NoViable" targetRef="BFinNo" name=""/>
    <bpmn:sequenceFlow id="B11" sourceRef="Rechazar" targetRef="BFinNo" name=""/>
    <bpmn:sequenceFlow id="B12" sourceRef="BLotes" targetRef="BFinSi" name=""/>
  </bpmn:process>
  <bpmn:collaboration id="ProcesoAbastecimiento_coll">
    <bpmn:participant id="ProcesoAbastecimiento_pool" name="NutriExpress S.R.L." processRef="ProcesoAbastecimiento"/>
    <bpmn:participant id="Proveedor" name="Proveedor"/>
    <bpmn:messageFlow id="M1" name="Solicitud" sourceRef="Solicitar" targetRef="Proveedor"/>
    <bpmn:messageFlow id="M2" name="Respuesta" sourceRef="Proveedor" targetRef="Respuesta"/>
    <bpmn:messageFlow id="M3" name="Aviso y entrega" sourceRef="Proveedor" targetRef="Entrega"/>
  </bpmn:collaboration>
